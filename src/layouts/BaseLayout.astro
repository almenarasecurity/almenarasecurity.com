---
import '@styles/global.css';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { getLangFromUrl, getAlternateUrl, getAbsoluteUrl, tUI } from '@i18n/utils';
import type { Locale } from '@i18n/utils';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
}

const { title, description, ogImage, noindex = false } = Astro.props;
const lang = getLangFromUrl(Astro.url) as Locale;
const currentPath = Astro.url.pathname;
const alternatePath = getAlternateUrl(currentPath, lang);
const canonicalUrl = getAbsoluteUrl(currentPath);
const enUrl = lang === 'en' ? canonicalUrl : getAbsoluteUrl(alternatePath);
const esUrl = lang === 'es' ? canonicalUrl : getAbsoluteUrl(alternatePath);
const ogImageUrl = ogImage || getAbsoluteUrl(lang === 'es' ? '/og-image-es.png' : '/og-image.png');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_ES'} />
    <meta property="og:site_name" content="Almenara Security" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {lang === 'es' && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Almenara Security",
        "url": "https://almenarasecurity.com",
        "logo": "https://almenarasecurity.com/almenara-logo.png",
        "description": "Pentesting profesional y formacion en concienciacion de ciberseguridad para pymes y empresas medianas.",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Malaga",
          "addressCountry": "ES"
        },
        "sameAs": []
      })} />
    )}
    {lang === 'en' && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Almenara Security",
        "url": "https://almenarasecurity.com",
        "logo": "https://almenarasecurity.com/almenara-logo.png",
        "description": "Professional pentesting and cybersecurity awareness training for SMBs and mid-sized companies.",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Malaga",
          "addressCountry": "ES"
        },
        "sameAs": []
      })} />
    )}

    <!-- Plausible Analytics (uncomment when ready)
    <script defer data-domain="almenarasecurity.com" src="https://plausible.io/js/script.js"></script>
    -->
  </head>
  <body>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-lg focus:bg-amber-500 focus:px-4 focus:py-2 focus:text-navy-950 focus:font-semibold focus:outline-none">
      {tUI('a11y.skip_to_content', lang)}
    </a>
    <Header lang={lang} />
    <main id="main-content">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

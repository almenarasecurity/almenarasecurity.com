---
---

<div class="relative w-full max-w-lg mx-auto" aria-hidden="true">
  <svg viewBox="0 0 500 400" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
    <defs>
      <linearGradient id="tower-grad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#1A3A5C" />
        <stop offset="100%" stop-color="#0A1E35" />
      </linearGradient>
      <linearGradient id="flame-grad" x1="0" y1="1" x2="0" y2="0">
        <stop offset="0%" stop-color="#C8861A" />
        <stop offset="50%" stop-color="#F5A623" />
        <stop offset="100%" stop-color="#FADDAE" />
      </linearGradient>
      <radialGradient id="glow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#F5A623" stop-opacity="0.3" />
        <stop offset="100%" stop-color="#F5A623" stop-opacity="0" />
      </radialGradient>
      <filter id="flame-blur">
        <feGaussianBlur stdDeviation="2" />
      </filter>
    </defs>

    <!-- Connection lines between towers -->
    <line x1="130" y1="190" x2="250" y2="140" stroke="#F5A623" stroke-width="1" stroke-opacity="0.3" stroke-dasharray="6 4">
      <animate attributeName="stroke-opacity" values="0.15;0.4;0.15" dur="3s" repeatCount="indefinite" />
    </line>
    <line x1="250" y1="140" x2="380" y2="180" stroke="#F5A623" stroke-width="1" stroke-opacity="0.3" stroke-dasharray="6 4">
      <animate attributeName="stroke-opacity" values="0.15;0.4;0.15" dur="3s" begin="0.5s" repeatCount="indefinite" />
    </line>
    <line x1="130" y1="190" x2="380" y2="180" stroke="#F5A623" stroke-width="0.5" stroke-opacity="0.15" stroke-dasharray="4 6">
      <animate attributeName="stroke-opacity" values="0.08;0.2;0.08" dur="4s" repeatCount="indefinite" />
    </line>

    <!-- Left tower (smaller, distant) -->
    <g transform="translate(100, 160)">
      <rect x="10" y="30" width="40" height="60" rx="2" fill="url(#tower-grad)" />
      <rect x="5" y="25" width="50" height="10" rx="1" fill="#1A3A5C" />
      <rect x="18" y="35" width="8" height="12" rx="1" fill="#0F2540" opacity="0.6" />
      <rect x="34" y="35" width="8" height="12" rx="1" fill="#0F2540" opacity="0.6" />
      <rect x="22" y="70" width="16" height="20" rx="3" fill="#C8861A" opacity="0.5" />
      <!-- Flame -->
      <circle cx="30" cy="15" r="12" fill="url(#glow)">
        <animate attributeName="r" values="10;14;10" dur="2s" repeatCount="indefinite" />
      </circle>
      <ellipse cx="30" cy="18" rx="4" ry="8" fill="url(#flame-grad)" filter="url(#flame-blur)">
        <animate attributeName="ry" values="7;9;7" dur="1.5s" repeatCount="indefinite" />
      </ellipse>
    </g>

    <!-- Center tower (main, larger) -->
    <g transform="translate(210, 90)">
      <rect x="10" y="50" width="60" height="85" rx="2" fill="url(#tower-grad)" />
      <rect x="3" y="43" width="74" height="12" rx="1" fill="#1A3A5C" />
      <polygon points="40,10 18,43 62,43" fill="#1A3A5C" />
      <!-- Windows -->
      <rect x="20" y="58" width="10" height="15" rx="1" fill="#0F2540" opacity="0.6" />
      <rect x="35" y="58" width="10" height="15" rx="1" fill="#0F2540" opacity="0.6" />
      <rect x="50" y="58" width="10" height="15" rx="1" fill="#0F2540" opacity="0.6" />
      <!-- Door -->
      <rect x="27" y="105" width="26" height="30" rx="6" fill="#C8861A" opacity="0.6" />
      <!-- Flame -->
      <circle cx="40" cy="0" r="18" fill="url(#glow)">
        <animate attributeName="r" values="15;20;15" dur="2.5s" repeatCount="indefinite" />
      </circle>
      <ellipse cx="40" cy="4" rx="5" ry="12" fill="url(#flame-grad)" filter="url(#flame-blur)">
        <animate attributeName="ry" values="10;13;10" dur="1.8s" repeatCount="indefinite" />
      </ellipse>
    </g>

    <!-- Right tower (medium) -->
    <g transform="translate(345, 145)">
      <rect x="10" y="35" width="50" height="70" rx="2" fill="url(#tower-grad)" />
      <rect x="4" y="28" width="62" height="12" rx="1" fill="#1A3A5C" />
      <rect x="20" y="40" width="9" height="13" rx="1" fill="#0F2540" opacity="0.6" />
      <rect x="37" y="40" width="9" height="13" rx="1" fill="#0F2540" opacity="0.6" />
      <rect x="25" y="80" width="20" height="25" rx="4" fill="#C8861A" opacity="0.5" />
      <!-- Flame -->
      <circle cx="35" cy="18" r="14" fill="url(#glow)">
        <animate attributeName="r" values="12;16;12" dur="2.2s" repeatCount="indefinite" />
      </circle>
      <ellipse cx="35" cy="21" rx="4.5" ry="10" fill="url(#flame-grad)" filter="url(#flame-blur)">
        <animate attributeName="ry" values="8;11;8" dur="1.6s" repeatCount="indefinite" />
      </ellipse>
    </g>

    <!-- Data nodes traveling along connections -->
    <circle r="3" fill="#F5A623" opacity="0.8">
      <animateMotion dur="3s" repeatCount="indefinite" path="M130,190 Q190,155 250,140" />
    </circle>
    <circle r="2.5" fill="#F5A623" opacity="0.6">
      <animateMotion dur="3.5s" repeatCount="indefinite" begin="1s" path="M250,140 Q315,150 380,180" />
    </circle>

    <!-- Threat indicator (red pulse) approaching from the right edge -->
    <circle cx="470" cy="220" r="6" fill="#EF4444" opacity="0.7">
      <animate attributeName="r" values="4;8;4" dur="1.5s" repeatCount="indefinite" />
      <animate attributeName="opacity" values="0.4;0.8;0.4" dur="1.5s" repeatCount="indefinite" />
    </circle>
    <circle cx="470" cy="220" r="14" fill="none" stroke="#EF4444" stroke-width="1" opacity="0.3">
      <animate attributeName="r" values="10;20;10" dur="1.5s" repeatCount="indefinite" />
      <animate attributeName="opacity" values="0.3;0;0.3" dur="1.5s" repeatCount="indefinite" />
    </circle>

    <!-- Coastline / horizon -->
    <path d="M0,320 Q60,310 130,315 Q200,320 250,312 Q300,305 380,310 Q440,316 500,308" stroke="#D9E2EC" stroke-width="1" fill="none" opacity="0.5" />
    <path d="M0,340 Q80,332 160,336 Q240,340 320,334 Q400,328 500,332" stroke="#D9E2EC" stroke-width="0.5" fill="none" opacity="0.3" />
  </svg>
</div>

---
interface Props {
  number: string;
  title: string;
  description: string;
  isLast?: boolean;
}

const { number, title, description, isLast = false } = Astro.props;
---

<div class="relative flex gap-6 lg:flex-col lg:gap-4">
  <div class="flex flex-col items-center lg:flex-row lg:gap-4">
    <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-amber-500 font-mono text-sm font-semibold text-navy-950">
      {number}
    </div>
    {!isLast && (
      <div class="mt-2 h-full w-px bg-gray-200 lg:mt-0 lg:h-px lg:w-full" aria-hidden="true"></div>
    )}
  </div>
  <div class="pb-8 lg:pb-0">
    <h3 class="text-lg font-bold text-navy-950">{title}</h3>
    <p class="mt-2 text-sm text-gray-600 leading-relaxed">{description}</p>
  </div>
</div>

---
import { getAlternateUrl, tUI } from '@i18n/utils';
import type { Locale } from '@i18n/utils';

interface Props {
  lang: Locale;
  class?: string;
}

const { lang, class: className = '' } = Astro.props;
const currentPath = Astro.url.pathname;
const alternatePath = getAlternateUrl(currentPath, lang);
---

<div class:list={['inline-flex items-center gap-1 text-sm font-medium', className]} role="navigation" aria-label={tUI('lang.switch_label', lang)}>
  <a
    href={lang === 'en' ? currentPath : alternatePath}
    class:list={[
      'px-2 py-1 rounded transition-colors',
      lang === 'en' ? 'bg-amber-500/15 text-amber-600 font-semibold' : 'text-gray-500 hover:text-gray-700'
    ]}
    aria-current={lang === 'en' ? 'true' : undefined}
    data-lang-switch="en"
  >
    EN
  </a>
  <span class="text-gray-300" aria-hidden="true">/</span>
  <a
    href={lang === 'es' ? currentPath : alternatePath}
    class:list={[
      'px-2 py-1 rounded transition-colors',
      lang === 'es' ? 'bg-amber-500/15 text-amber-600 font-semibold' : 'text-gray-500 hover:text-gray-700'
    ]}
    aria-current={lang === 'es' ? 'true' : undefined}
    data-lang-switch="es"
  >
    ES
  </a>
</div>

<script is:inline>
  document.querySelectorAll('[data-lang-switch]').forEach(function(el) {
    el.addEventListener('click', function(e) {
      var lang = el.getAttribute('data-lang-switch');
      try { localStorage.setItem('almenara-lang', lang); } catch(e) {}
    });
  });
</script>

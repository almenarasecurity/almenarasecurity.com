---
import Logo from './Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getLocalizedPath, tUI } from '@i18n/utils';
import type { Locale } from '@i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const navItems = [
  { label: tUI('nav.services', lang), href: getLocalizedPath('/services/pentesting', lang), hasDropdown: true },
  { label: tUI('nav.about', lang), href: getLocalizedPath('/about', lang) },
  { label: tUI('nav.contact', lang), href: getLocalizedPath('/contact', lang) },
];

const serviceItems = [
  { label: tUI('nav.pentesting', lang), href: getLocalizedPath('/services/pentesting', lang) },
  { label: tUI('nav.ppf', lang), href: getLocalizedPath('/services/pay-per-finding', lang) },
  { label: tUI('nav.awareness', lang), href: getLocalizedPath('/services/awareness-training', lang) },
  { label: tUI('nav.consulting', lang), href: getLocalizedPath('/services/consulting', lang) },
  { label: tUI('nav.secdev', lang), href: getLocalizedPath('/services/secure-development', lang) },
];
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <nav class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between lg:h-20">
      <a href={getLocalizedPath('/', lang)} class="header-logo" aria-label={tUI('a11y.home_link', lang)}>
        <Logo variant="horizontal" light />
      </a>

      <div class="hidden lg:flex lg:items-center lg:gap-8">
        {navItems.map((item) => (
          item.hasDropdown ? (
            <div class="group relative">
              <button class="header-nav-link inline-flex items-center gap-1 text-sm font-medium transition-colors" type="button">
                {item.label}
                <svg class="h-4 w-4 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="invisible absolute left-0 top-full pt-2 opacity-0 transition-all group-hover:visible group-hover:opacity-100">
                <div class="w-48 rounded-xl border border-gray-200 bg-white py-2 shadow-lg">
                  {serviceItems.map((sub) => (
                    <a href={sub.href} class="block px-4 py-2 text-sm text-gray-700 transition-colors hover:bg-gray-50 hover:text-navy-950">
                      {sub.label}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a href={item.href} class="header-nav-link text-sm font-medium transition-colors">
              {item.label}
            </a>
          )
        ))}
        <LanguageSwitcher lang={lang} class="lang-switcher" />
        <a href={getLocalizedPath('/contact', lang)} class="rounded-lg bg-amber-500 px-4 py-2 text-sm font-semibold text-navy-950 transition-colors hover:bg-amber-400">
          {tUI('cta.contact_us', lang)}
        </a>
      </div>

      <div class="flex items-center gap-3 lg:hidden">
        <LanguageSwitcher lang={lang} class="lang-switcher" />
        <button
          id="mobile-menu-toggle"
          type="button"
          class="header-nav-link inline-flex items-center justify-center rounded-lg p-2"
          aria-expanded="false"
          aria-label={tUI('a11y.menu_open', lang)}
        >
          <svg id="menu-icon-open" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="hidden lg:hidden">
      <div class="border-t border-gray-200 pb-4 pt-3">
        <div class="space-y-1">
          {serviceItems.map((item) => (
            <a href={item.href} class="block rounded-lg px-3 py-2 text-base font-medium text-gray-700 hover:bg-gray-50 hover:text-navy-950">
              {item.label}
            </a>
          ))}
          {navItems.filter(i => !i.hasDropdown).map((item) => (
            <a href={item.href} class="block rounded-lg px-3 py-2 text-base font-medium text-gray-700 hover:bg-gray-50 hover:text-navy-950">
              {item.label}
            </a>
          ))}
        </div>
        <div class="mt-4 px-3">
          <a href={getLocalizedPath('/contact', lang)} class="block w-full rounded-lg bg-amber-500 px-4 py-2.5 text-center text-sm font-semibold text-navy-950 transition-colors hover:bg-amber-400">
            {tUI('cta.contact_us', lang)}
          </a>
        </div>
      </div>
    </div>
  </nav>
</header>

<style is:global>
  .header-nav-link {
    color: white;
    transition: color 0.3s;
  }
  .header-nav-link:hover {
    color: rgba(255, 255, 255, 0.75);
  }
  #site-header[data-scrolled] .header-nav-link {
    color: var(--color-gray-700);
  }
  #site-header[data-scrolled] .header-nav-link:hover {
    color: var(--color-navy-950);
  }
  .header-logo .text-white {
    transition: color 0.3s;
  }
  #site-header[data-scrolled] .header-logo .text-white {
    color: var(--color-navy-950);
  }
  #site-header:not([data-scrolled]) .lang-switcher .text-gray-500 {
    color: rgba(255, 255, 255, 0.6);
  }
  #site-header:not([data-scrolled]) .lang-switcher .text-gray-500:hover {
    color: white;
  }
  #site-header:not([data-scrolled]) .lang-switcher .text-gray-300 {
    color: rgba(255, 255, 255, 0.35);
  }
</style>

<script is:inline>
  (function() {
    var header = document.getElementById('site-header');
    var toggle = document.getElementById('mobile-menu-toggle');
    var menu = document.getElementById('mobile-menu');
    var iconOpen = document.getElementById('menu-icon-open');
    var iconClose = document.getElementById('menu-icon-close');
    var isOpen = false;

    function updateHeader() {
      if (window.scrollY > 10 || isOpen) {
        header.dataset.scrolled = '';
        header.classList.add('bg-white/95', 'backdrop-blur-md', 'shadow-sm');
      } else {
        delete header.dataset.scrolled;
        header.classList.remove('bg-white/95', 'backdrop-blur-md', 'shadow-sm');
      }
    }

    toggle.addEventListener('click', function() {
      isOpen = !isOpen;
      menu.classList.toggle('hidden', !isOpen);
      iconOpen.classList.toggle('hidden', isOpen);
      iconClose.classList.toggle('hidden', !isOpen);
      toggle.setAttribute('aria-expanded', String(isOpen));
      updateHeader();
    });

    menu.querySelectorAll('a').forEach(function(link) {
      link.addEventListener('click', function() {
        isOpen = false;
        menu.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
        updateHeader();
      });
    });

    window.addEventListener('scroll', updateHeader, { passive: true });
    updateHeader();
  })();
</script>

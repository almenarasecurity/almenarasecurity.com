---
import Logo from './Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getLocalizedPath, tUI } from '@i18n/utils';
import type { Locale } from '@i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-gray-200 bg-gray-50">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-1">
        <Logo variant="horizontal" />
        <p class="mt-4 text-sm text-gray-500">
          {tUI('footer.tagline', lang)}
        </p>
        <p class="mt-2 text-sm text-gray-400">
          {tUI('footer.malaga', lang)}
        </p>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-navy-950">{tUI('footer.services', lang)}</h3>
        <ul class="mt-4 space-y-3">
          <li>
            <a href={getLocalizedPath('/services/pentesting', lang)} class="text-sm text-gray-500 transition-colors hover:text-navy-950">
              {tUI('nav.pentesting', lang)}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/services/pay-per-finding', lang)} class="text-sm text-gray-500 transition-colors hover:text-navy-950">
              {tUI('nav.ppf', lang)}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/services/awareness-training', lang)} class="text-sm text-gray-500 transition-colors hover:text-navy-950">
              {tUI('nav.awareness', lang)}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/services/consulting', lang)} class="text-sm text-gray-500 transition-colors hover:text-navy-950">
              {tUI('nav.consulting', lang)}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/services/secure-development', lang)} class="text-sm text-gray-500 transition-colors hover:text-navy-950">
              {tUI('nav.secdev', lang)}
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-navy-950">{tUI('footer.company', lang)}</h3>
        <ul class="mt-4 space-y-3">
          <li>
            <a href={getLocalizedPath('/about', lang)} class="text-sm text-gray-500 transition-colors hover:text-navy-950">
              {tUI('nav.about', lang)}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/contact', lang)} class="text-sm text-gray-500 transition-colors hover:text-navy-950">
              {tUI('nav.contact', lang)}
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-navy-950">{tUI('footer.legal', lang)}</h3>
        <ul class="mt-4 space-y-3">
          <li>
            <a href={getLocalizedPath('/legal-notice', lang)} class="text-sm text-gray-500 transition-colors hover:text-navy-950">
              {tUI('footer.legal_notice', lang)}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/privacy', lang)} class="text-sm text-gray-500 transition-colors hover:text-navy-950">
              {tUI('footer.privacy', lang)}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/cookies', lang)} class="text-sm text-gray-500 transition-colors hover:text-navy-950">
              {tUI('footer.cookies', lang)}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-gray-200 pt-8 sm:flex-row">
      <p class="text-sm text-gray-400">
        &copy; {year} {tUI('footer.copyright', lang)}
      </p>
      <div class="flex items-center gap-4">
        <!-- TODO: add LinkedIn URL -->
        <a href="#" class="text-gray-400 transition-colors hover:text-navy-950" aria-label="LinkedIn" rel="noopener noreferrer">
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
        <LanguageSwitcher lang={lang} />
      </div>
    </div>
  </div>
</footer>

---
import { tUI, getLocalizedPath } from '@i18n/utils';
import type { Locale } from '@i18n/utils';

interface Props {
  lang: Locale;
  preselectedService?: string;
}

const { lang, preselectedService } = Astro.props;
---

<form
  id="contact-form"
  action={import.meta.env.PUBLIC_FORMSPREE_ENDPOINT || '#'}
  method="POST"
  class="space-y-5"
>
  <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />
  <input type="hidden" name="_language" value={lang} />

  <div>
    <label for="name" class="block text-sm font-medium text-navy-950">{tUI('contact_form.name', lang)} *</label>
    <input
      type="text"
      id="name"
      name="name"
      required
      class="mt-1.5 block w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-gray-900 transition-colors focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-amber-500"
    />
  </div>

  <div>
    <label for="email" class="block text-sm font-medium text-navy-950">{tUI('contact_form.email', lang)} *</label>
    <input
      type="email"
      id="email"
      name="email"
      required
      class="mt-1.5 block w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-gray-900 transition-colors focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-amber-500"
    />
  </div>

  <div>
    <label for="company" class="block text-sm font-medium text-navy-950">{tUI('contact_form.company', lang)} *</label>
    <input
      type="text"
      id="company"
      name="company"
      required
      class="mt-1.5 block w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-gray-900 transition-colors focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-amber-500"
    />
  </div>

  <div>
    <label for="company-size" class="block text-sm font-medium text-navy-950">{tUI('contact_form.company_size', lang)}</label>
    <select
      id="company-size"
      name="company_size"
      class="mt-1.5 block w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-gray-900 transition-colors focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-amber-500"
    >
      <option value="">—</option>
      <option value="1-10">{tUI('contact_form.size_1_10', lang)}</option>
      <option value="11-50">{tUI('contact_form.size_11_50', lang)}</option>
      <option value="51-200">{tUI('contact_form.size_51_200', lang)}</option>
      <option value="200+">{tUI('contact_form.size_200_plus', lang)}</option>
    </select>
  </div>

  <div>
    <label for="service" class="block text-sm font-medium text-navy-950">{tUI('contact_form.service', lang)}</label>
    <select
      id="service"
      name="service"
      class="mt-1.5 block w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-gray-900 transition-colors focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-amber-500"
    >
      <option value="">—</option>
      <option value="pentesting" selected={preselectedService === 'pentesting'}>{tUI('contact_form.service_pentesting', lang)}</option>
      <option value="ppf" selected={preselectedService === 'ppf'}>{tUI('contact_form.service_ppf', lang)}</option>
      <option value="awareness" selected={preselectedService === 'awareness'}>{tUI('contact_form.service_awareness', lang)}</option>
      <option value="consulting" selected={preselectedService === 'consulting'}>{tUI('contact_form.service_consulting', lang)}</option>
      <option value="secdev" selected={preselectedService === 'secdev'}>{tUI('contact_form.service_secdev', lang)}</option>
      <option value="other" selected={preselectedService === 'other'}>{tUI('contact_form.service_other', lang)}</option>
    </select>
  </div>

  <div>
    <label for="message" class="block text-sm font-medium text-navy-950">{tUI('contact_form.message', lang)} *</label>
    <textarea
      id="message"
      name="message"
      rows="4"
      required
      minlength="30"
      class="mt-1.5 block w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-gray-900 transition-colors focus:border-amber-500 focus:outline-none focus:ring-1 focus:ring-amber-500 resize-y"
      placeholder={tUI('contact_form.message_placeholder', lang)}
    ></textarea>
  </div>

  <div class="flex items-start gap-3">
    <input
      type="checkbox"
      id="privacy"
      name="privacy"
      required
      class="mt-1 h-4 w-4 rounded border-gray-300 text-amber-500 focus:ring-amber-500"
    />
    <label for="privacy" class="text-sm text-gray-600">
      {tUI('contact_form.privacy_accept', lang)}{' '}
      <a href={getLocalizedPath('/privacy', lang)} class="text-amber-600 underline hover:text-amber-700">
        {tUI('contact_form.privacy_link', lang)}
      </a> *
    </label>
  </div>

  <button
    type="submit"
    id="submit-btn"
    class="w-full rounded-lg bg-amber-500 px-6 py-3 text-sm font-semibold text-navy-950 transition-colors hover:bg-amber-400 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed"
  >
    {tUI('cta.send_message', lang)}
  </button>

  <div id="form-success" class="hidden rounded-lg bg-green-50 border border-green-200 p-4">
    <p class="font-semibold text-green-800">{tUI('contact_form.success_title', lang)}</p>
    <p class="mt-1 text-sm text-green-700">{tUI('contact_form.success_text', lang)}</p>
  </div>

  <div id="form-error" class="hidden rounded-lg bg-red-50 border border-red-200 p-4">
    <p class="font-semibold text-red-800">{tUI('contact_form.error_title', lang)}</p>
    <p class="mt-1 text-sm text-red-700">
      {tUI('contact_form.error_text', lang)} <a href="mailto:info@almenarasecurity.com" class="underline">info@almenarasecurity.com</a>
    </p>
  </div>
</form>

<script is:inline>
  (function() {
    var form = document.getElementById('contact-form');
    var btn = document.getElementById('submit-btn');
    var successEl = document.getElementById('form-success');
    var errorEl = document.getElementById('form-error');
    if (!form) return;

    var params = new URLSearchParams(window.location.search);
    var svc = params.get('service') || params.get('servicio');
    if (svc) {
      var sel = document.getElementById('service');
      if (sel) {
        var map = { pentesting: 'pentesting', awareness: 'awareness', concienciacion: 'awareness', consulting: 'consulting', consultoria: 'consulting', secdev: 'secdev', 'desarrollo-seguro': 'secdev', ppf: 'ppf', 'pago-por-hallazgo': 'ppf', 'pay-per-finding': 'ppf' };
        var val = map[svc] || svc;
        for (var i = 0; i < sel.options.length; i++) {
          if (sel.options[i].value === val) { sel.selectedIndex = i; break; }
        }
      }
    }

    form.addEventListener('submit', function(e) {
      e.preventDefault();
      var action = form.getAttribute('action');
      if (!action || action === '#') return;

      btn.disabled = true;
      btn.textContent = btn.dataset.sending || 'Sending...';
      successEl.classList.add('hidden');
      errorEl.classList.add('hidden');

      fetch(action, {
        method: 'POST',
        body: new FormData(form),
        headers: { 'Accept': 'application/json' }
      }).then(function(r) {
        if (r.ok) {
          form.reset();
          successEl.classList.remove('hidden');
        } else {
          errorEl.classList.remove('hidden');
        }
      }).catch(function() {
        errorEl.classList.remove('hidden');
      }).finally(function() {
        btn.disabled = false;
        btn.textContent = btn.dataset.label || 'Send message';
      });
    });
  })();
</script>

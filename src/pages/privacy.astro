---
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/Section.astro';
import { t } from '@i18n/utils';

const lang = 'en' as const;
---

<BaseLayout
  title={`${t('privacy_page.title', lang)} | Almenara Security`}
  description={t('privacy_page.meta_description', lang)}
>
  <section class="bg-navy-950 pt-28 pb-16 lg:pt-36 lg:pb-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-extrabold tracking-tight text-white">{t('privacy_page.title', lang)}</h1>
    </div>
  </section>

  <Section bg="white">
    <!-- TODO: replace with real privacy policy reviewed by a lawyer (RGPD/LOPD-GDD compliant) -->
    <div class="prose prose-gray mx-auto max-w-3xl">
      <h2>Data controller</h2>
      <ul>
        <li><strong>Controller:</strong> Julio Martínez Martínez-Checa (Almenara Security)</li>
        <li><strong>NIF:</strong> Available upon request at info@almenarasecurity.com</li>
        <li><strong>Location:</strong> Málaga, Spain</li>
        <li><strong>Email:</strong> info@almenarasecurity.com</li>
      </ul>

      <h2>Purpose of data processing</h2>
      <p>We collect personal data through our contact form for the following purposes:</p>
      <ul>
        <li>Responding to inquiries about our services</li>
        <li>Preparing and sending service proposals</li>
        <li>Managing the commercial relationship</li>
      </ul>

      <h2>Legal basis</h2>
      <p>The legal basis for processing your data is your explicit consent when submitting the contact form, as well as our legitimate interest in responding to service inquiries.</p>

      <h2>Data recipients</h2>
      <p>Your data may be processed by Formspree (form submission service) as a data processor. We do not sell or share your personal data with third parties for marketing purposes.</p>

      <h2>Data retention</h2>
      <p>Personal data will be retained for the duration of the commercial relationship and for the legally required period thereafter.</p>

      <h2>Your rights</h2>
      <p>Under the GDPR and LOPD-GDD, you have the right to:</p>
      <ul>
        <li>Access your personal data</li>
        <li>Rectify inaccurate data</li>
        <li>Request erasure of your data</li>
        <li>Object to or restrict processing</li>
        <li>Data portability</li>
        <li>Lodge a complaint with the Spanish Data Protection Agency (AEPD)</li>
      </ul>
      <p>To exercise these rights, contact us at info@almenarasecurity.com.</p>

      <h2>Security measures</h2>
      <p>We implement appropriate technical and organizational measures to protect your personal data against unauthorized access, alteration, disclosure, or destruction.</p>
    </div>
  </Section>
</BaseLayout>

---
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/Section.astro';
import { t } from '@i18n/utils';

const lang = 'es' as const;
---

<BaseLayout
  title={`${t('about_page.title', lang)} | Almenara Security`}
  description={t('about_page.meta_description', lang)}
>
  <section class="bg-navy-950 pt-28 pb-16 lg:pt-36 lg:pb-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
          {t('about_page.hero_title', lang)}
        </h1>
        <p class="mt-6 text-lg text-navy-200 leading-relaxed">
          {t('about_page.hero_subtitle', lang)}
        </p>
      </div>
    </div>
  </section>

  <Section bg="white">
    <div class="mx-auto max-w-3xl space-y-6 text-gray-600 leading-relaxed text-lg">
      <p>{t('about_page.story.p1', lang)}</p>
      <p>{t('about_page.story.p2', lang)}</p>
      <p>{t('about_page.story.p3', lang)}</p>
      <p class="font-medium text-navy-950">{t('about_page.story.p4', lang)}</p>
    </div>
  </Section>

  <Section bg="gray">
    <h2 class="text-center text-3xl font-bold text-navy-950">{t('about_page.values.title', lang)}</h2>
    <div class="mt-12 grid gap-8 md:grid-cols-2">
      {[0, 1, 2, 3].map((i) => (
        <div class="rounded-xl border border-gray-200 bg-white p-8">
          <h3 class="text-lg font-bold text-navy-950">{t(`about_page.values.items.${i}.title` as any, lang)}</h3>
          <p class="mt-3 text-gray-600 leading-relaxed">{t(`about_page.values.items.${i}.description` as any, lang)}</p>
        </div>
      ))}
    </div>
  </Section>

  <Section bg="white">
    <h2 class="text-center text-3xl font-bold text-navy-950">{t('about_page.team.title', lang)}</h2>
    <div class="mt-12 mx-auto max-w-3xl space-y-6">

      <!-- Julio Martinez -->
      <div class="rounded-2xl border border-gray-200 bg-white p-8 md:p-10">
        <div class="flex flex-col items-center gap-8 md:flex-row md:items-start">
          <img
            src="/julio-martinez.jpg"
            alt="Julio Martinez"
            class="h-32 w-32 rounded-full object-cover ring-4 ring-navy-50 shrink-0"
          />
          <div>
            <h3 class="text-xl font-bold text-navy-950">{t('about_page.team.julio.name', lang)}</h3>
            <p class="mt-1 text-sm font-medium text-amber-600">{t('about_page.team.julio.role', lang)}</p>
            <p class="mt-4 text-gray-600 leading-relaxed">{t('about_page.team.julio.bio', lang)}</p>
            <p class="mt-3 text-gray-600 leading-relaxed">{t('about_page.team.julio.bio_2', lang)}</p>

            <div class="mt-6 flex flex-wrap gap-2">
              {['OSCP', 'C-AI/MLPen', 'CAPen', 'AWS Security', 'LFCS'].map((cert) => (
                <span class="inline-block rounded-full bg-navy-50 px-3 py-1 font-mono text-xs font-medium text-navy-700">{cert}</span>
              ))}
            </div>

            <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-gray-500">
              <span class="flex items-center gap-1.5">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 006-6v-1.5m-6 7.5a6 6 0 01-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 01-3-3V4.5a3 3 0 116 0v8.25a3 3 0 01-3 3z" />
                </svg>
                Cybercamp, Navaja Negra
              </span>
              <a href={t('about_page.team.julio.linkedin', lang)} class="flex items-center gap-1.5 text-gray-500 transition-colors hover:text-navy-950" target="_blank" rel="noopener noreferrer">
                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
                LinkedIn
              </a>
              <a href={t('about_page.team.julio.github', lang)} class="flex items-center gap-1.5 text-gray-500 transition-colors hover:text-navy-950" target="_blank" rel="noopener noreferrer">
                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
                </svg>
                GitHub
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Víctor Reyes -->
      <div class="rounded-2xl border border-gray-200 bg-white p-8 md:p-10">
        <div class="flex flex-col items-center gap-8 md:flex-row md:items-start">
          <img
            src="/victor-reyes.jpg"
            alt="Víctor Reyes"
            class="h-32 w-32 rounded-full object-cover ring-4 ring-navy-50 shrink-0"
          />
          <div>
            <h3 class="text-xl font-bold text-navy-950">{t('about_page.team.victor.name', lang)}</h3>
            <p class="mt-1 text-sm font-medium text-amber-600">{t('about_page.team.victor.role', lang)}</p>
            <p class="mt-4 text-gray-600 leading-relaxed">{t('about_page.team.victor.bio', lang)}</p>
            <p class="mt-3 text-gray-600 leading-relaxed">{t('about_page.team.victor.bio_2', lang)}</p>

            <div class="mt-6 flex flex-wrap gap-2">
              {(t('about_page.team.victor.skills', lang) as unknown as string[]).map((skill: string) => (
                <span class="inline-block rounded-full bg-navy-50 px-3 py-1 font-mono text-xs font-medium text-navy-700">{skill}</span>
              ))}
            </div>

            <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-gray-500">
              <span class="flex items-center gap-1.5">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 006-6v-1.5m-6 7.5a6 6 0 01-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 01-3-3V4.5a3 3 0 116 0v8.25a3 3 0 01-3 3z" />
                </svg>
                Navaja Negra, RootedCON
              </span>
              <a href={t('about_page.team.victor.linkedin', lang)} class="flex items-center gap-1.5 text-gray-500 transition-colors hover:text-navy-950" target="_blank" rel="noopener noreferrer">
                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
                LinkedIn
              </a>
              <a href={t('about_page.team.victor.github', lang)} class="flex items-center gap-1.5 text-gray-500 transition-colors hover:text-navy-950" target="_blank" rel="noopener noreferrer">
                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
                </svg>
                GitHub
              </a>
            </div>
          </div>
        </div>
      </div>

    </div>
  </Section>

  <Section bg="gray">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="text-3xl font-bold text-navy-950">{t('about_page.malaga.title', lang)}</h2>
      <p class="mt-6 text-lg text-gray-600 leading-relaxed">{t('about_page.malaga.description', lang)}</p>
    </div>
  </Section>
</BaseLayout>

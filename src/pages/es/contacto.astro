---
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/Section.astro';
import ContactForm from '@components/ContactForm.astro';
import { t } from '@i18n/utils';

const lang = 'es' as const;
---

<BaseLayout
  title={`${t('contact_page.title', lang)} | Almenara Security`}
  description={t('contact_page.meta_description', lang)}
>
  <section class="bg-navy-950 pt-28 pb-16 lg:pt-36 lg:pb-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
          {t('contact_page.hero_title', lang)}
        </h1>
        <p class="mt-6 text-lg text-navy-200 leading-relaxed">
          {t('contact_page.hero_subtitle', lang)}
        </p>
      </div>
    </div>
  </section>

  <Section bg="white">
    <div class="grid gap-16 lg:grid-cols-5">
      <div class="lg:col-span-3">
        <ContactForm lang={lang} />
      </div>
      <div class="lg:col-span-2">
        <div class="sticky top-28">
          <h2 class="text-xl font-bold text-navy-950">{t('contact_page.expect.title', lang)}</h2>
          <ul class="mt-6 space-y-4">
            {[0, 1, 2, 3].map((i) => (
              <li class="flex items-start gap-3 text-gray-600">
                <svg class="mt-1 h-5 w-5 shrink-0 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                {t(`contact_page.expect.items.${i}` as any, lang)}
              </li>
            ))}
          </ul>
          <div class="mt-10 rounded-xl border border-gray-200 bg-gray-50 p-6">
            <p class="text-sm text-gray-500">{t('contact_page.email_label', lang)}</p>
            <a href="mailto:info@almenarasecurity.com" class="mt-1 block font-mono text-sm font-medium text-amber-600 hover:text-amber-700">
              {t('contact_page.email', lang)}
            </a>
          </div>
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>

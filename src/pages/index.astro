---
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/Section.astro';
import Button from '@components/Button.astro';
import ServiceCard from '@components/ServiceCard.astro';
import ProcessStep from '@components/ProcessStep.astro';
import FAQ from '@components/FAQ.astro';
import HeroDiagram from '@components/HeroDiagram.astro';
import { t } from '@i18n/utils';
import { getLocalizedPath } from '@i18n/utils';

const lang = 'en' as const;
---

<BaseLayout
  title="Almenara Security | Pentesting & Cybersecurity Training for SMBs"
  description={t('hero.subtitle', lang)}
>
  <Fragment slot="default">
    <!-- Language detection: only runs on the root EN page -->
    <script is:inline>
      (function() {
        try {
          var saved = localStorage.getItem('almenara-lang');
          if (saved === 'es') { window.location.replace('/es/'); return; }
          if (saved === 'en') { document.documentElement.dataset.ready = 'true'; return; }
          var bl = (navigator.language || '').toLowerCase();
          if (bl.startsWith('es')) { window.location.replace('/es/'); return; }
          document.documentElement.dataset.ready = 'true';
        } catch(e) { document.documentElement.dataset.ready = 'true'; }
      })();
    </script>
    <style>
      body { opacity: 0; }
      html[data-ready] body { opacity: 1; transition: opacity 150ms ease; }
    </style>

    <!-- Hero -->
    <section class="relative overflow-hidden bg-navy-950 pt-28 pb-20 lg:pt-36 lg:pb-28">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid items-center gap-12 lg:grid-cols-5 lg:gap-16">
          <div class="lg:col-span-3">
            <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl">
              {t('hero.title', lang)}
            </h1>
            <p class="mt-6 max-w-xl text-lg text-navy-200 leading-relaxed">
              {t('hero.subtitle', lang)}
            </p>
            <div class="mt-10 flex flex-wrap gap-4">
              <Button href={getLocalizedPath('/contact', lang) + '?service=pentesting'} variant="primary" size="lg">
                {t('hero.cta_primary', lang)}
              </Button>
              <Button href="#services" variant="outline-light" size="lg">
                {t('hero.cta_secondary', lang)}
              </Button>
            </div>
          </div>
          <div class="lg:col-span-2">
            <HeroDiagram />
          </div>
        </div>
      </div>
    </section>

    <!-- Why Almenara -->
    <Section bg="white">
      <div class="text-center">
        <h2 class="text-3xl font-bold text-navy-950 sm:text-4xl">{t('why.section_title', lang)}</h2>
      </div>
      <div class="mt-16 grid gap-10 md:grid-cols-3">
        {(['pentest', 'reports', 'training'] as const).map((key) => (
          <div class="text-center">
            <div class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-amber-50">
              {key === 'pentest' && (
                <svg class="h-7 w-7 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5" />
                </svg>
              )}
              {key === 'reports' && (
                <svg class="h-7 w-7 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                </svg>
              )}
              {key === 'training' && (
                <svg class="h-7 w-7 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 00-.491 6.347A48.62 48.62 0 0112 20.904a48.62 48.62 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.636 50.636 0 00-2.658-.813A59.906 59.906 0 0112 3.493a59.903 59.903 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5" />
                </svg>
              )}
            </div>
            <h3 class="text-lg font-bold text-navy-950">{t(`why.items.${key}.title`, lang)}</h3>
            <p class="mt-3 text-gray-600 leading-relaxed">{t(`why.items.${key}.description`, lang)}</p>
          </div>
        ))}
      </div>
    </Section>

    <!-- Services -->
    <Section id="services" bg="gray">
      <div class="text-center">
        <h2 class="text-3xl font-bold text-navy-950 sm:text-4xl">{t('services.section_title', lang)}</h2>
      </div>
      <div class="mt-16 grid gap-8 lg:grid-cols-2">
        <ServiceCard
          title={t('services.pentesting.title', lang)}
          description={t('services.pentesting.description', lang)}
          bullets={[
            t('services.pentesting.bullets.0' as any, lang),
            t('services.pentesting.bullets.1' as any, lang),
            t('services.pentesting.bullets.2' as any, lang),
            t('services.pentesting.bullets.3' as any, lang),
          ]}
          href={getLocalizedPath('/services/pentesting', lang)}
          ctaText={t('services.pentesting.cta', lang)}
          icon="shield"
        />
        <ServiceCard
          title={t('services.ppf.title', lang)}
          description={t('services.ppf.description', lang)}
          bullets={[
            t('services.ppf.bullets.0' as any, lang),
            t('services.ppf.bullets.1' as any, lang),
            t('services.ppf.bullets.2' as any, lang),
            t('services.ppf.bullets.3' as any, lang),
          ]}
          href={getLocalizedPath('/services/pay-per-finding', lang)}
          ctaText={t('services.ppf.cta', lang)}
          icon="target"
        />
        <ServiceCard
          title={t('services.awareness.title', lang)}
          description={t('services.awareness.description', lang)}
          bullets={[
            t('services.awareness.bullets.0' as any, lang),
            t('services.awareness.bullets.1' as any, lang),
            t('services.awareness.bullets.2' as any, lang),
            t('services.awareness.bullets.3' as any, lang),
          ]}
          href={getLocalizedPath('/services/awareness-training', lang)}
          ctaText={t('services.awareness.cta', lang)}
          icon="users"
        />
        <ServiceCard
          title={t('services.consulting.title', lang)}
          description={t('services.consulting.description', lang)}
          bullets={[
            t('services.consulting.bullets.0' as any, lang),
            t('services.consulting.bullets.1' as any, lang),
            t('services.consulting.bullets.2' as any, lang),
            t('services.consulting.bullets.3' as any, lang),
          ]}
          href={getLocalizedPath('/services/consulting', lang)}
          ctaText={t('services.consulting.cta', lang)}
          icon="chat"
        />
        <ServiceCard
          title={t('services.secdev.title', lang)}
          description={t('services.secdev.description', lang)}
          bullets={[
            t('services.secdev.bullets.0' as any, lang),
            t('services.secdev.bullets.1' as any, lang),
            t('services.secdev.bullets.2' as any, lang),
            t('services.secdev.bullets.3' as any, lang),
          ]}
          href={getLocalizedPath('/services/secure-development', lang)}
          ctaText={t('services.secdev.cta', lang)}
          icon="code"
        />
      </div>
    </Section>

    <!-- Process -->
    <Section bg="white">
      <div class="text-center">
        <h2 class="text-3xl font-bold text-navy-950 sm:text-4xl">{t('process.section_title', lang)}</h2>
        <p class="mt-4 text-lg text-gray-600">{t('process.section_subtitle', lang)}</p>
      </div>
      <div class="mt-16 grid gap-0 md:grid-cols-4">
        {(['recon', 'analysis', 'exploitation', 'report'] as const).map((step, i) => (
          <ProcessStep
            number={t(`process.steps.${step}.number`, lang)}
            title={t(`process.steps.${step}.title`, lang)}
            description={t(`process.steps.${step}.description`, lang)}
            isLast={i === 3}
          />
        ))}
      </div>
    </Section>

    <!-- Sectors -->
    <Section bg="gray">
      <div class="text-center">
        <h2 class="text-3xl font-bold text-navy-950 sm:text-4xl">{t('sectors.section_title', lang)}</h2>
        <p class="mt-4 text-lg text-gray-600">{t('sectors.section_subtitle', lang)}</p>
      </div>
      <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {(['ecommerce', 'saas', 'legal', 'health', 'hospitality', 'industry'] as const).map((key) => (
          <div class="rounded-xl border border-gray-200 bg-white p-6 transition-colors hover:border-amber-300">
            <div class="mb-3 inline-flex h-10 w-10 items-center justify-center rounded-lg bg-navy-50 text-navy-700">
              {key === 'ecommerce' && (
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z" /></svg>
              )}
              {key === 'saas' && (
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15a4.5 4.5 0 004.5 4.5H18a3.75 3.75 0 001.332-7.257 3 3 0 00-3.758-3.848 5.25 5.25 0 00-10.233 2.33A4.502 4.502 0 002.25 15z" /></svg>
              )}
              {key === 'legal' && (
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v17.25m0 0c-1.472 0-2.882.265-4.185.75M12 20.25c1.472 0 2.882.265 4.185.75M18.75 4.97A48.416 48.416 0 0012 4.5c-2.291 0-4.545.16-6.75.47m13.5 0c1.01.143 2.01.317 3 .52m-3-.52l2.62 10.726c.122.499-.106 1.028-.589 1.202a5.988 5.988 0 01-2.031.352 5.988 5.988 0 01-2.031-.352c-.483-.174-.711-.703-.59-1.202L18.75 4.971zm-16.5.52c.99-.203 1.99-.377 3-.52m0 0l2.62 10.726c.122.499-.106 1.028-.589 1.202a5.989 5.989 0 01-2.031.352 5.989 5.989 0 01-2.031-.352c-.483-.174-.711-.703-.59-1.202L5.25 4.971z" /></svg>
              )}
              {key === 'health' && (
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" /></svg>
              )}
              {key === 'hospitality' && (
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 21v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21m0 0h4.5V3.545M12.75 21h7.5V10.75M2.25 21h1.5m18 0h-18M2.25 9l4.5-1.636M18.75 3l-1.5.545m0 6.205l3 1m1.5.5l-1.5-.5M6.75 7.364V3h-3v18m3-13.636l10.5-3.819" /></svg>
              )}
              {key === 'industry' && (
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17l-5.1-3.06A1.5 1.5 0 005 13.5V21a1.5 1.5 0 001.5 1.5h2.25a1.5 1.5 0 001.5-1.5V15a.75.75 0 01.12-.41m0 0A1.5 1.5 0 0112 14.25a1.5 1.5 0 011.38.91l.12.41V21a1.5 1.5 0 001.5 1.5h2.25A1.5 1.5 0 0019.5 21v-7.5a1.5 1.5 0 00-1.32-1.44l-5.1-3.06a1.5 1.5 0 00-1.58 0z" /></svg>
              )}
            </div>
            <h3 class="font-semibold text-navy-950">{t(`sectors.items.${key}.title`, lang)}</h3>
            <p class="mt-1 text-sm text-gray-500">{t(`sectors.items.${key}.description`, lang)}</p>
          </div>
        ))}
      </div>
    </Section>

    <!-- Testimonials placeholder -->
    <Section bg="white">
      <div class="text-center">
        <h2 class="text-3xl font-bold text-navy-950 sm:text-4xl">{t('testimonials.section_title', lang)}</h2>
        <!-- TODO: replace with real testimonials -->
        <p class="mt-6 text-gray-400 italic">Coming soon.</p>
      </div>
    </Section>

    <!-- FAQ -->
    <Section bg="gray">
      <div class="mx-auto max-w-3xl">
        <h2 class="text-center text-3xl font-bold text-navy-950 sm:text-4xl">{t('faq.section_title', lang)}</h2>
        <div class="mt-12">
          <FAQ items={[
            { q: t('faq.items.0.q' as any, lang), a: t('faq.items.0.a' as any, lang) },
            { q: t('faq.items.1.q' as any, lang), a: t('faq.items.1.a' as any, lang) },
            { q: t('faq.items.2.q' as any, lang), a: t('faq.items.2.a' as any, lang) },
            { q: t('faq.items.3.q' as any, lang), a: t('faq.items.3.a' as any, lang) },
            { q: t('faq.items.4.q' as any, lang), a: t('faq.items.4.a' as any, lang) },
            { q: t('faq.items.5.q' as any, lang), a: t('faq.items.5.a' as any, lang) },
          ]} />
        </div>
      </div>
    </Section>

    <!-- Final CTA -->
    <Section bg="navy">
      <div class="text-center">
        <h2 class="text-3xl font-bold text-white sm:text-4xl">{t('cta_final.title', lang)}</h2>
        <p class="mt-4 text-lg text-navy-200">{t('cta_final.subtitle', lang)}</p>
        <div class="mt-10">
          <Button href={getLocalizedPath('/contact', lang)} variant="primary" size="lg">
            {t('cta_final.cta', lang)}
          </Button>
        </div>
      </div>
    </Section>
  </Fragment>
</BaseLayout>

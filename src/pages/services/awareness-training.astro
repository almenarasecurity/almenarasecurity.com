---
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/Section.astro';
import Button from '@components/Button.astro';
import { t, getLocalizedPath } from '@i18n/utils';

const lang = 'en' as const;
---

<BaseLayout
  title={`${t('awareness_page.title', lang)} | Almenara Security`}
  description={t('awareness_page.meta_description', lang)}
>
  <!-- Hero -->
  <section class="bg-navy-950 pt-28 pb-16 lg:pt-36 lg:pb-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="inline-block rounded-full bg-amber-500/15 px-4 py-1.5 font-mono text-xs font-medium text-amber-400 tracking-wider uppercase">{t('awareness_page.title', lang)}</span>
        <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
          {t('awareness_page.hero_title', lang)}
        </h1>
        <p class="mt-6 text-lg text-navy-200 leading-relaxed">
          {t('awareness_page.hero_subtitle', lang)}
        </p>
      </div>
    </div>
  </section>

  <!-- Human factor -->
  <Section bg="white">
    <div class="grid items-center gap-12 lg:grid-cols-2">
      <div>
        <h2 class="text-3xl font-bold text-navy-950">{t('awareness_page.human_factor.title', lang)}</h2>
        <p class="mt-6 text-gray-600 leading-relaxed">{t('awareness_page.human_factor.description', lang)}</p>
      </div>
      <div class="rounded-2xl border border-amber-200 bg-amber-50 p-10 text-center">
        <div class="font-mono text-6xl font-bold text-amber-600">{t('awareness_page.human_factor.stat', lang)}</div>
        <p class="mt-3 text-lg font-medium text-navy-950">{t('awareness_page.human_factor.stat_label', lang)}</p>
        <p class="mt-2 text-sm text-gray-500">{t('awareness_page.human_factor.source', lang)}</p>
      </div>
    </div>
  </Section>

  <!-- How it works -->
  <Section bg="gray">
    <h2 class="text-3xl font-bold text-navy-950">{t('awareness_page.how.title', lang)}</h2>
    <div class="mt-12 grid gap-8 md:grid-cols-2">
      {[0, 1, 2, 3].map((i) => (
        <div class="rounded-xl border border-gray-200 bg-white p-8">
          <h3 class="text-lg font-bold text-navy-950">{t(`awareness_page.how.items.${i}.title` as any, lang)}</h3>
          <p class="mt-3 text-gray-600 leading-relaxed">{t(`awareness_page.how.items.${i}.description` as any, lang)}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- Topics -->
  <Section bg="white">
    <div class="max-w-3xl">
      <h2 class="text-3xl font-bold text-navy-950">{t('awareness_page.topics.title', lang)}</h2>
      <ul class="mt-8 grid gap-3 sm:grid-cols-2">
        {[0, 1, 2, 3, 4, 5, 6, 7].map((i) => (
          <li class="flex items-start gap-3 text-gray-600">
            <svg class="mt-1 h-5 w-5 shrink-0 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            {t(`awareness_page.topics.items.${i}` as any, lang)}
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <!-- Simulations -->
  <Section bg="gray">
    <div class="max-w-3xl">
      <h2 class="text-3xl font-bold text-navy-950">{t('awareness_page.simulations.title', lang)}</h2>
      <p class="mt-6 text-gray-600 leading-relaxed">{t('awareness_page.simulations.description', lang)}</p>
    </div>
  </Section>

  <!-- CTA -->
  <Section bg="navy">
    <div class="text-center">
      <h2 class="text-3xl font-bold text-white">{t('awareness_page.cta.title', lang)}</h2>
      <p class="mt-4 text-lg text-navy-200">{t('awareness_page.cta.subtitle', lang)}</p>
      <div class="mt-10">
        <Button href={getLocalizedPath('/contact', lang) + '?service=awareness'} variant="primary" size="lg">
          {t('awareness_page.cta.button', lang)}
        </Button>
      </div>
    </div>
  </Section>
</BaseLayout>
